# Copy this file to ".env" and fill in your own key.
# Get a free API key at https://openrouter.ai/keys
#
# Never share this file or paste your real key into a chat, email, or
# public repository. If a key is ever exposed, delete it on the
# OpenRouter dashboard and generate a new one immediately.

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Browse available models (including free ones) at
# https://openrouter.ai/models
OPENROUTER_MODEL_ID=meta-llama/llama-3.1-8b-instruct:free
