# Copy this file to ".env" and fill in your own key.
# Get an API key from https://platform.openai.com/account/api-keys
#
# Never share this file or paste your real key into a chat, email, or
# public repository. If a key is ever exposed, delete it on the OpenAI
# dashboard and generate a new one immediately.

OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL_ID=gpt-4o-mini
